# Obrigatório para registrar o primeiro coordenador
COGNIX_SETUP_CODE=SUBSTITUA-POR-UM-CODIGO-LONGO-ALEATORIO
# Opcional. Use 1 somente quando estiver servindo HTTPS em produção.
COGNIX_SECURE_COOKIES=0
# Arquivo sqlite local; em produção, usar armazenamento durável e backups.
COGNIX_DB=data/cognix.sqlite3
# API ENEM pública (ou instância self-hosted controlada por você)
ENEM_API_BASE=https://api.enem.dev/v1
# Integração opcional com Gemini (definir como variável de ambiente no servidor)
GEMINI_API_KEY=
COGNIX_GEMINI_MODEL=gemini-3.5-flash
COGNIX_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
